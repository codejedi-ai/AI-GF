# LiveKit server
LIVEKIT_URL=wss://<your-livekit-server>.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Providers — only the ones your agent JSONs use are needed
OPENAI_API_KEY=
GOOGLE_API_KEY=
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=
SMALLEST_API_KEY=
RIME_API_KEY=
ELEVENLABS_API_KEY=
INFLECTION_AI_KEY=

# Optional: default agent when --config is not passed (stem of a JSON in data/agent_template/)
# SELECTED_AGENT=ludia
